preset raw;
varying highp vec4 foliageColor;
uniform highp float wind_phase;
uniform highp float wind_speed;
uniform highp float wind_strength;

void vertex() {
    highp vec2 root = (modelMatrix * vec3(aPos, 1.0)).xy;
    highp float front = dot(root, vec2(0.12, 0.08));
    highp float gust = sin(TIME * 1.25 * wind_speed + wind_phase - front);
    highp float flutter = sin(TIME * 2.1 * wind_speed + wind_phase * 1.7 - front * 1.3);
    highp float canopy = tCoord2.y;
    VERTEX.x += (gust * 0.06 + flutter * 0.012) * canopy * wind_strength;
    VERTEX = apply_mvp(VERTEX);
    UV = mix(modifyUV.xy, modifyUV.zw, tCoord);
    foliageColor = zFromSrgb(modulate);
}

void fragment() {
    highp vec4 lighting = texture2D(lightMap, FRAGCOORD.xy * SCREEN_PIXEL_SIZE);
    COLOR = zTexture(UV) * foliageColor * lighting;
}
