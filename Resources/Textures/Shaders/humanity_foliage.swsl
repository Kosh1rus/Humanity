uniform highp float wind_phase;
uniform highp float wind_speed;
uniform highp float wind_strength;
uniform highp float brush_strength;
uniform highp float work_strength;

void vertex() {
    highp vec2 root = (modelMatrix * vec3(aPos, 1.0)).xy;
    highp float front = dot(root, vec2(0.12, 0.08));
    highp float gust = sin(TIME * 1.25 * wind_speed + wind_phase - front);
    highp float flutter = sin(TIME * 2.1 * wind_speed + wind_phase * 1.7 - front * 1.3);
    highp float canopy = tCoord2.y;
    highp float bend = (gust * 0.06 + flutter * 0.012) * canopy * wind_strength;
    bend += brush_strength * canopy * 0.1;
    bend += work_strength * canopy * 0.07;
    VERTEX += (projectionMatrix * viewMatrix * modelMatrix * vec3(bend, 0.0, 0.0)).xy;
}

void fragment() {
    COLOR = zTexture(UV);
    COLOR.rgb = mix(COLOR.rgb, COLOR.rgb * 1.12 + vec3(0.015, 0.014, 0.004), 0.45);
}
