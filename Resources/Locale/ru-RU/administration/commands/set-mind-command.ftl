set-mind-command-description = Переносит разум в указанную сущность. У неё должен быть компонент {$requiredComponent}. По умолчанию разум, временно управляющий другой сущностью, вернётся обратно — например, призрак вернётся в своё тело.
set-mind-command-help-text = Использование: {$command} <UID сущности> <имя игрока> [unvisit]
set-mind-command-target-has-no-content-data-message = У выбранного игрока нет игровых данных.
set-mind-command-target-has-no-mind-message = У выбранной сущности нет разума. Возможно, её забыли сделать разумной?
cmd-mind-command-hint = имя игрока
