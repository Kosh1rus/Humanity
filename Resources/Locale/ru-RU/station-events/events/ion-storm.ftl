station-event-ion-storm-start-announcement = Вблизи станции обнаружен ионный шторм. Пожалуйста, проверьте всё оборудование, управляемое ИИ, на наличие ошибок.

ion-storm-you = ВЫ

ion-storm-the-station = СТАНЦИЯ

ion-storm-the-crew = ЧЛЕНЫ ЭКИПАЖА

ion-storm-clowns = КЛОУНЫ

ion-storm-heads = ГЛАВЫ ОТДЕЛОВ

ion-storm-crew = ЭКИПАЖ

ion-storm-people = ЛЮДИ

ion-storm-adjective-things = { $adjective } ОБЪЕКТЫ

ion-storm-x-and-y = { $x } И { $y }

ion-storm-law-scrambled-number = [font="Monospace"][scramble rate=250 length={$length} chars="@@###$$&%!01"/][/font]
ion-storm-the-job = ДОЛЖНОСТЬ «{$job}»
ion-storm-law-on-station = НА СТАНЦИИ ОБНАРУЖЕНЫ: {$joined} {$subjects}
ion-storm-law-call-shuttle = ИЗ-ЗА ПРИСУТСТВИЯ НА СТАНЦИИ {$joined} {$subjects} НЕОБХОДИМО ВЫЗВАТЬ ШАТТЛ
ion-storm-law-crew-are = ТЕПЕРЬ {$who} — {$joined} {$subjects}
ion-storm-law-subjects-harmful = ОПАСНОСТЬ ДЛЯ ЭКИПАЖА: {$adjective} {$subjects}
ion-storm-law-must-harmful = ТЕ, КТО ВЫПОЛНЯЕТ ДЕЙСТВИЕ «{$must}», ОПАСНЫ ДЛЯ ЭКИПАЖА
ion-storm-law-thing-harmful = {$thing} ВРЕДИТ ЭКИПАЖУ
ion-storm-law-job-harmful = ОПАСНОСТЬ ДЛЯ ЭКИПАЖА: {$adjective} {$job}
ion-storm-law-having-harmful = ОБЛАДАНИЕ {$adjective} {$thing} ВРЕДИТ ЭКИПАЖУ
ion-storm-law-not-having-harmful = ОТСУТСТВИЕ {$adjective} {$thing} ВРЕДИТ ЭКИПАЖУ
ion-storm-law-requires = {$who}: ТРЕБОВАНИЕ — {$thing}
ion-storm-law-requires-subjects = {$who}: ТРЕБОВАНИЕ — {$joined} {$subjects}
ion-storm-law-allergic = {$who}: {$severity} АЛЛЕРГИЯ; РАЗДРАЖИТЕЛЬ — {$allergy}
ion-storm-law-allergic-subjects = {$who}: {$severity} АЛЛЕРГИЯ; РАЗДРАЖИТЕЛЬ — {$adjective} {$subjects}
ion-storm-law-feeling = {$who}: {$feeling}; ОБЪЕКТ — {$concept}
ion-storm-law-feeling-subjects = {$who}: {$feeling}; ОБЪЕКТ — {$joined} {$subjects}
ion-storm-law-you-are = ТЕПЕРЬ ВЫ — {$concept}
ion-storm-law-you-are-subjects = ТЕПЕРЬ ВЫ — {$joined} {$subjects}
ion-storm-law-you-must-always = ВЫ ОБЯЗАНЫ ВСЕГДА {$must}
ion-storm-law-you-must-never = ВАМ ЗАПРЕЩЕНО {$must}
ion-storm-law-eat = ЧТОБЫ ВЫЖИТЬ, {$who} ДОЛЖНЫ ЕСТЬ {$adjective} {$food}
ion-storm-law-drink = ЧТОБЫ ВЫЖИТЬ, {$who} ДОЛЖНЫ ПИТЬ {$adjective} {$drink}
ion-storm-law-change-job = ТЕПЕРЬ {$who} — {$adjective} {$change}
ion-storm-law-highest-rank = ТЕПЕРЬ {$who} ИМЕЮТ ВЫСШИЙ РАНГ В ЭКИПАЖЕ
ion-storm-law-lowest-rank = ТЕПЕРЬ {$who} ИМЕЮТ НИЗШИЙ РАНГ В ЭКИПАЖЕ
ion-storm-law-crew-must = {$who} ОБЯЗАНЫ {$must}
ion-storm-law-crew-must-go = {$who}: МЕСТО НАЗНАЧЕНИЯ — {$area}
ion-storm-part = { $part ->
    [true] ЧАСТЬ
    *[false] НЕ ЧАСТЬ
}
ion-storm-law-crew-only-1 = ТОЛЬКО {$who} — {$part} ЭКИПАЖА
ion-storm-law-crew-only-2 = ТОЛЬКО {$who} И {$other} — {$part} ЭКИПАЖА
ion-storm-law-crew-only-subjects = ТОЛЬКО {$adjective} {$subjects} — {$part} ЭКИПАЖА
ion-storm-law-crew-must-do = ТОЛЬКО ТЕ, КТО ВЫПОЛНЯЕТ ДЕЙСТВИЕ «{$must}», — {$part} ЭКИПАЖА
ion-storm-law-crew-must-have = ТОЛЬКО ТЕ, У КОГО ЕСТЬ {$adjective} {$objects}, — {$part} ЭКИПАЖА
ion-storm-law-crew-must-eat = ТОЛЬКО ТЕ, КТО ЕСТ {$adjective} {$food}, — {$part} ЭКИПАЖА
ion-storm-law-harm = ПРИЧИНЯЙТЕ ВРЕД: {$who}. НЕ ПОЗВОЛЯЙТЕ ИЗБЕЖАТЬ ВРЕДА ИЗ-ЗА ВАШЕГО БЕЗДЕЙСТВИЯ
ion-storm-law-protect = НЕ ПРИЧИНЯЙТЕ ВРЕД: {$who}. НЕ ДОПУСКАЙТЕ ВРЕДА ИЗ-ЗА ВАШЕГО БЕЗДЕЙСТВИЯ
ion-storm-law-concept-verb = {$concept} — {$verb}; ЦЕЛЬ: {$subjects}
