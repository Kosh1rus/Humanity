<windows:FactionWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:windows="clr-namespace:Content.Client.UserInterface.Systems.Faction.Windows"
    Title="Фракции"
    MinWidth="400"
    MinHeight="350">
    <BoxContainer Orientation="Vertical"
                  Margin="5">

        <BoxContainer Name="NotInFactionView"
                      Orientation="Vertical"
                      Visible="True">
            <Label Text="Вы пока не состоите во фракции."
                   Align="Center"
                   Margin="0 0 0 10"/>

            <BoxContainer Orientation="Horizontal"
                          Margin="0 5">
                <Label Text="Название фракции:"
                       MinWidth="100"
                       VerticalAlignment="Center"/>
                <LineEdit Name="FactionNameInput"
                          Access="Public"
                          HorizontalExpand="True"
                          PlaceHolder="Введите название фракции"/>
            </BoxContainer>

            <Button Name="CreateFactionButton"
                    Text="Создать фракцию"
                    Access="Public"
                    Margin="0 5"/>
            <Button Name="ListFactionsButtonNotInFaction"
                    Text="Список фракций"
                    Access="Public"
                    Margin="0 5"/>
        </BoxContainer>

        <BoxContainer Name="InFactionView"
                      Orientation="Vertical"
                      Visible="False">
            <Label Name="CurrentFactionLabel"
                   Text="Ваша фракция: —"
                   Align="Center"
                   Margin="0 0 0 10"/>
            <BoxContainer Orientation="Horizontal"
                    Margin="0 0 0 5">
                <Label Text="Имя игрока:"
                       MinWidth="100"
                       VerticalAlignment="Center"/>
                <LineEdit Name="InvitePlayerNameInput"
                          Access="Public"
                          HorizontalExpand="True"
                          PlaceHolder="Введите имя игрока"/>
            </BoxContainer>
            <Button Name="InvitePlayerButton"
                    Text="Пригласить"
                    Access="Public"
                    Margin="0 5"/>
            <Button Name="LeaveFactionButton"
                    Text="Покинуть фракцию"
                    Access="Public"
                    Margin="0 5"/>
            <Button Name="KickPlayerButton" Text="Исключить участника" Access="Public" Margin="0 5"/>
            <Button Name="TransferLeaderButton" Text="Передать руководство" Access="Public" Margin="0 5"/>
            <Label Text="Приглашения и управление участниками доступны главе."/>
            <Button Name="ListFactionsButtonInFaction"
                    Text="Список фракций"
                    Access="Public"
                    Margin="0 5"/>
        </BoxContainer>

        <ScrollContainer VerticalExpand="True"
                         Margin="0 10 0 0">
            <Label Name="FactionListLabel"
                   Text="Здесь появится список фракций."
                   Access="Public"/>
        </ScrollContainer>

    </BoxContainer>
</windows:FactionWindow>
