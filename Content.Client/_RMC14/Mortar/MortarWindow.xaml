<controls:MortarWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Mortar"
    Title="{Loc 'rmc-mortar-interface'}" MinWidth="360">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <Label Text="{Loc 'humanity-mortar-heading'}" />
        <BoxContainer Name="HeadingContainer" Access="Public" Orientation="Horizontal" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Button Name="LeftCoarse" Access="Public" Text="−15°" HorizontalExpand="True" />
            <Button Name="RightCoarse" Access="Public" Text="+15°" HorizontalExpand="True" />
        </BoxContainer>
        <Label Text="{Loc 'humanity-mortar-range'}" />
        <BoxContainer Name="RangeContainer" Access="Public" Orientation="Horizontal" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Button Name="NearCoarse" Access="Public" Text="−10 м" HorizontalExpand="True" />
            <Button Name="FarCoarse" Access="Public" Text="+10 м" HorizontalExpand="True" />
        </BoxContainer>
        <Label Name="LimitsLabel" Access="Public" />
        <Label Name="StatusLabel" Access="Public" />
        <Button Name="FireButton" Access="Public" Text="{Loc 'humanity-mortar-fire'}" />
    </BoxContainer>
</controls:MortarWindow>
